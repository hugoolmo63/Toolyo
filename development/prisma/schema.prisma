generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Categoría — entidad de ejemplo del scaffold (caso dummy).
/// Demuestra el patrón completo: id cuid, campo único (slug),
/// auto-referencia (parentId), estado (showInNav) y auditoría/soft-delete.
model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  showInNav Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryChildren")
  listings  Listing[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([parentId])
  @@index([showInNav])
}

enum AccountStatus {
  pending
  active
  suspended
  deletion_requested
  deleted
}

enum UserRole {
  user
  ADMIN
  MODERATOR
}

enum VerificationChannel {
  email
  phone
  identity
}

enum ContactVerificationStatus {
  pending
  verified
  blocked
}

enum OtpPurpose {
  registration
  contact_verification
  credential_change
  recovery
}

enum OtpChannel {
  email
  phone
}

enum IdentityVerificationStatus {
  not_started
  pending
  verified
  rejected
  retry_required
}

enum LegalDocumentType {
  terms
  privacy
  marketing
  kyc
}

enum LegalAcceptancePurpose {
  account_terms
  privacy_notice
  marketing
  kyc
}

enum SecurityEventOutcome {
  success
  failure
  blocked
}

enum BookingStatus {
  pending
  accepted
  rejected
  cancelled
  active
  completed
}

enum MessageType {
  text
  image
  system
}

enum AttachmentType {
  image
}

enum ReviewDirection {
  renter_to_owner
  owner_to_renter
}

enum ReviewStatus {
  hidden
  published
  under_review
  removed
}

enum ReviewReportReason {
  offensive
  inappropriate
  false
  irrelevant
}

enum ReviewReportStatus {
  open
  resolved
  dismissed
}

model User {
  id                       String                    @id @default(cuid())
  emailNormalized          String                    @unique
  phoneE164                String?                   @unique
  accountStatus            AccountStatus             @default(pending)
  role                     UserRole                  @default(user)
  displayName              String?                   @db.VarChar(100)
  avatarUrl                String?                   @db.VarChar(512)
  bio                      String?                   @db.Text
  preferredLocation        String?                   @db.VarChar(160)
  ratingAverage            Decimal?                  @db.Decimal(2, 1)
  responseTimeHours        Int?
  transactionCount         Int?                      @default(0)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  passwordCredential       PasswordCredential?
  oauthAccounts            OAuthAccount[]
  verificationStates       VerificationState[]
  otpChallenges            OtpChallenge[]
  identityVerifications    IdentityVerification[]
  kycReviews               IdentityVerification[]  @relation("KycReviewer")
  legalAcceptances         LegalAcceptance[]
  securityEvents           SecurityEvent[]
  sessions                 Session[]
  listings                 Listing[]
  reviewsWritten           Review[]
  reviewsReceived          Review[]                  @relation("Reviewee")
  reviewReports            ReviewReport[]            @relation("ReviewReporter")
  totpCredential           TotpCredential?
  adminAuditLogs           AdminAuditLog[]         @relation("AdminAuditActor")
  resolvedReviewReports    ReviewReport[]            @relation("ReviewResolver")
  bookingsAsRenter         Booking[]                 @relation("BookingRenter")
  bookingsAsOwner          Booking[]                 @relation("BookingOwner")
  bookingStatusChanges     BookingStatusHistory[]    @relation("BookingStatusChangedBy")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("MessageSender")
  uploadedAttachments      AttachmentUpload[]        @relation("AttachmentUploadOwner")
  devicePushTokens         DevicePushToken[]
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  changedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationState {
  id              String                    @id @default(cuid())
  userId          String
  channel         VerificationChannel
  status          ContactVerificationStatus @default(pending)
  verifiedAt      DateTime?                 @db.Timestamptz(6)
  lastRequestedAt DateTime?                 @db.Timestamptz(6)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(6)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, channel])
  @@index([channel, status])
}

model OtpChallenge {
  id              String     @id @default(cuid())
  userId          String?
  channel         OtpChannel
  purpose         OtpPurpose
  destinationHash String
  codeHash        String
  expiresAt       DateTime   @db.Timestamptz(6)
  attemptCount    Int        @default(0)
  resendCount     Int        @default(0)
  consumedAt      DateTime?  @db.Timestamptz(6)
  blockedAt       DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  user            User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, channel, purpose, createdAt])
  @@index([expiresAt])
}

model IdentityVerification {
  id                String                     @id @default(cuid())
  userId            String
  provider          String
  providerReference String                     @unique
  status            IdentityVerificationStatus @default(not_started)
  resultCode        String?
  reviewedById      String?
  reviewedAt        DateTime?                  @db.Timestamptz(6)
  reviewReason      String?                    @db.Text
  termsVersion      String
  startedAt         DateTime?                  @db.Timestamptz(6)
  completedAt       DateTime?                  @db.Timestamptz(6)
  reviewedBy        User?                      @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)
  @@index([status, createdAt])
  @@index([reviewedById, reviewedAt])
  user              User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

model LegalDocument {
  id               String            @id @default(cuid())
  documentType     LegalDocumentType
  version          String
  language         String
  effectiveAt      DateTime          @db.Timestamptz(6)
  retiredAt        DateTime?         @db.Timestamptz(6)
  contentHash      String
  legalAcceptances LegalAcceptance[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([documentType, version, language])
  @@index([documentType, effectiveAt])
}

model LegalAcceptance {
  id              String                 @id @default(cuid())
  userId          String
  legalDocumentId String
  purpose         LegalAcceptancePurpose
  acceptedAt      DateTime               @db.Timestamptz(6)
  context         Json?
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument          @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@index([userId, legalDocumentId, acceptedAt])
}

model SecurityEvent {
  id        String               @id @default(cuid())
  eventType String
  outcome   SecurityEventOutcome
  userId    String?
  requestId String?
  metadata  Json?
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  user      User?                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

/// Credencial TOTP cifrada; nunca debe incluirse en selects de usuario ni logs.
model TotpCredential {
  id               String    @id @default(cuid())
  userId           String    @unique
  secretCiphertext String    @db.Text
  keyVersion       String    @db.VarChar(64)
  isEnabled        Boolean   @default(false)
  setupStartedAt   DateTime? @db.Timestamptz(6)
  enabledAt        DateTime? @db.Timestamptz(6)
  lastUsedAt       DateTime? @db.Timestamptz(6)
  failedAttempts   Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

enum AdminAuditOutcome {
  success
  denied
  validation_error
  failure
}

/// Append-only administrative audit record. Application role must not update/delete rows.
model AdminAuditLog {
  id           String             @id @default(cuid())
  actorId      String?
  actorRole    UserRole?
  procedure    String             @db.VarChar(160)
  action       String             @db.VarChar(120)
  resourceType String?            @db.VarChar(80)
  resourceId   String?            @db.VarChar(128)
  outcome      AdminAuditOutcome
  reason       String?            @db.Text
  requestId    String?            @db.VarChar(128)
  clientIp     String?            @db.VarChar(64)
  userAgent    String?            @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  actor        User?              @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([procedure, outcome, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
}

/// Sesión opaca respaldada por DB — token aleatorio en cookie HttpOnly (003-login).
/// Revocable marcando `revokedAt` o eliminando la fila. Una sesión es válida si
/// `revokedAt IS NULL` AND `expiresAt > now()`.
model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// 004-public-search — Búsqueda pública y listings
// ─────────────────────────────────────────────────────────────

/// Estado de publicación de un listing. Solo `published` aparece en búsqueda pública.
enum ListingStatus {
  draft
  in_review
  published
  paused
  rejected
}

/// Listing — publicación de un producto disponible para alquiler.
/// Modelo mínimo introducido en 004-public-search para servir resultados de búsqueda;
/// la feature de listings (§2) lo extenderá con wizard, precios escalonados, etc.
model Listing {
  id               String                                @id @default(cuid())
  ownerId          String
  categoryId       String
  title            String
  slug             String                                @unique
  description      String?                               @db.Text
  pricePerDay      Decimal                               @db.Decimal(19, 4)
  /// Punto geoespacial PostGIS (geometry(Point, 4326)). Prisma no soporta el tipo
  /// nativamente; se gestiona via SQL raw en migraciones y queries. Ver DATABASE.md §5.4.
  location         Unsupported("geometry(Point, 4326)")?
  lat              Decimal?                              @db.Decimal(10, 7)
  lng              Decimal?                              @db.Decimal(10, 7)
  addressText      String?
  city             String?
  status           ListingStatus                         @default(draft)
  ratingAverage    Decimal                               @default(0) @db.Decimal(3, 2)
  reviewCount      Int                                   @default(0)
  viewCount        Int                                   @default(0)
  isInstantBooking Boolean                               @default(false)
  createdAt        DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                              @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?                             @db.Timestamptz(6)

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos        ListingPhoto[]
  availability  ListingAvailability[]
  embedding     ListingEmbedding?
  reviews       Review[]
  bookings      Booking[]
  conversations Conversation[]

  @@index([status, deletedAt])
  @@index([categoryId, status, deletedAt])
  @@index([ownerId, status])
  @@index([pricePerDay])
  @@index([ratingAverage])
}

/// Valoración pública de un listing realizada por un usuario.
model Review {
  id            String           @id @default(cuid())
  /// Nullable for compatibility with legacy listing reviews; new review submissions require it.
  bookingId     String?
  listingId     String
  authorId      String
  /// Nullable for compatibility with legacy listing reviews; new submissions require both fields.
  revieweeId    String?
  direction     ReviewDirection?
  status        ReviewStatus     @default(hidden)
  /// Campo legado usado por las vistas de listing existentes.
  rating        Int              @default(0)
  overallRating Int              @default(0)
  comment       String?          @db.Text
  submittedAt   DateTime         @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime?        @db.Timestamptz(6)
  publishedAt   DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?        @db.Timestamptz(6)

  booking        Booking?              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author         User                  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reviewee       User?                 @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Restrict)
  categoryScores ReviewCategoryScore[]
  reports        ReviewReport[]
  Listing        Listing               @relation(fields: [listingId], references: [id])

  @@unique([bookingId, authorId, direction])
  @@index([listingId, status, deletedAt, createdAt])
  @@index([revieweeId, status, createdAt])
  @@index([bookingId, status])
  @@index([status, expiresAt, deletedAt])
}

model ReviewCategoryScore {
  id       String @id @default(cuid())
  reviewId String
  category String @db.VarChar(64)
  rating   Int

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, category])
  @@index([category, rating])
}

model ReviewReport {
  id           String             @id @default(cuid())
  reviewId     String
  reporterId   String
  reason       ReviewReportReason
  description  String?            @db.Text
  status       ReviewReportStatus @default(open)
  resolution   String?            @db.Text
  resolvedById String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime?          @db.Timestamptz(6)

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reporter   User   @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User?  @relation("ReviewResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([reviewId, reporterId, reason, status])
  @@index([reviewId, status, createdAt])
  @@index([reporterId, status, createdAt])
}

/// Embedding semántico generado por OpenAI para búsqueda pgvector.
/// El tipo vector no está soportado nativamente por Prisma y se consulta con SQL raw.
model ListingEmbedding {
  id         String                     @id
  listingId  String                     @unique
  model      String
  dimensions Int
  embedding  Unsupported("vector(384)")
  createdAt  DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                   @updatedAt @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

/// Foto de un listing. La feature de listings (§2) añadirá hasta 10 con ordenación drag & drop.
model ListingPhoto {
  id        String    @id @default(cuid())
  listingId String
  url       String
  altText   String?
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, order, deletedAt])
}

/// Bloqueo de calendario de un listing (fecha no disponible).
/// La feature de listings (§2) añadirá el calendario completo con bloqueos manuales.
model ListingAvailability {
  id          String   @id @default(cuid())
  listingId   String
  blockedDate DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, blockedDate])
  @@index([listingId, blockedDate])
}

/// Reserva y snapshot financiero de un alquiler.
model Booking {
  id                 String        @id @default(cuid())
  listingId          String
  renterId           String
  ownerId            String
  conversationId     String        @unique
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  status             BookingStatus @default(pending)
  completedAt        DateTime?     @db.Timestamptz(6)
  pricePerDay        Decimal       @db.Decimal(19, 4)
  totalDays          Int
  subtotal           Decimal       @db.Decimal(19, 4)
  serviceFee         Decimal       @db.Decimal(19, 4)
  totalPrice         Decimal       @db.Decimal(19, 4)
  currencyCode       String        @default("EUR") @db.Char(3)
  idempotencyKey     String
  rejectionReason    String?       @db.Text
  lastTransitionById String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?     @db.Timestamptz(6)

  listing       Listing                @relation(fields: [listingId], references: [id], onDelete: Restrict)
  renter        User                   @relation("BookingRenter", fields: [renterId], references: [id], onDelete: Restrict)
  owner         User                   @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  conversation  Conversation           @relation("BookingConversation", fields: [conversationId], references: [id], onDelete: Restrict)
  statusHistory BookingStatusHistory[]
  reviews       Review[]

  @@unique([renterId, idempotencyKey])
  @@index([listingId, status, startDate, endDate])
  @@index([renterId, createdAt])
  @@index([ownerId, createdAt])
}

/// Auditoría inmutable de cada transición de estado de una reserva.
model BookingStatusHistory {
  id          String         @id @default(cuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String
  reason      String?        @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  changedBy User    @relation("BookingStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([changedById, createdAt])
}

/// Hilo privado asociado opcionalmente a un listing y a una reserva.
model Conversation {
  id        String    @id @default(cuid())
  listingId String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  listing           Listing?                  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  booking           Booking?                  @relation("BookingConversation")
  participants      ConversationParticipant[]
  messages          Message[]
  attachmentUploads AttachmentUpload[]

  @@index([listingId, updatedAt])
  @@index([deletedAt, updatedAt])
}

/// Usuario que pertenece a una conversación y su cursor de lectura.
model ConversationParticipant {
  conversationId    String
  userId            String
  lastReadMessageId String?
  joinedAt          DateTime  @default(now()) @db.Timestamptz(6)
  lastReadAt        DateTime? @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

/// Mensaje persistente; el contenido se conserva para poder recuperar el historial.
model Message {
  id              String      @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String
  type            MessageType @default(text)
  body            String?     @db.Text
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?   @db.Timestamptz(6)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments  MessageAttachment[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}

/// Upload prefirmado confirmado, pendiente de asociarse a un mensaje.
model AttachmentUpload {
  id             String    @id @default(cuid())
  conversationId String
  uploadedById   String
  storageKey     String    @unique @db.VarChar(512)
  publicUrl      String    @db.VarChar(1024)
  mimeType       String    @db.VarChar(100)
  byteSize       Int
  width          Int?
  height         Int?
  checksum       String?
  confirmedAt    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation("AttachmentUploadOwner", fields: [uploadedById], references: [id], onDelete: Restrict)
  message      MessageAttachment?

  @@index([conversationId, uploadedById, expiresAt])
}

/// Metadatos de un archivo almacenado fuera de PostgreSQL.
model MessageAttachment {
  id         String         @id @default(cuid())
  messageId  String
  uploadId   String?        @unique
  type       AttachmentType @default(image)
  storageKey String         @db.VarChar(512)
  publicUrl  String         @db.VarChar(1024)
  mimeType   String         @db.VarChar(100)
  byteSize   Int
  width      Int?
  height     Int?
  checksum   String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  deletedAt  DateTime?      @db.Timestamptz(6)

  message Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  upload  AttachmentUpload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
  @@index([storageKey])
}

// ─────────────────────────────────────────────────────────────
// 014-app-movil-multiplataforma — Notificaciones push móviles
// ─────────────────────────────────────────────────────────────

/// Plataforma del dispositivo que registra un token de notificaciones.
enum MobilePlatform {
  android
  ios
}

/// Token de dispositivo para notificaciones push (FCM/APNs).
/// Un usuario puede tener varios dispositivos/plataformas.
model DevicePushToken {
  id                   String         @id @default(cuid())
  userId               String
  platform             MobilePlatform
  token                String         @unique @db.VarChar(512)
  deviceId             String?        @db.VarChar(191)
  appVersion           String?        @db.VarChar(40)
  osVersion            String?        @db.VarChar(40)
  locale               String?        @db.VarChar(20)
  notificationsEnabled Boolean        @default(true)
  lastSeenAt           DateTime?      @db.Timestamptz(6)
  revokedAt            DateTime?      @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(6)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, platform])
  @@index([userId, revokedAt])
  @@index([platform, notificationsEnabled])
  @@index([lastSeenAt])
}
