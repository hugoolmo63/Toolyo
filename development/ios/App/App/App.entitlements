<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Usa "production" para distribución (App Store / ad-hoc). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links. Sustituye el dominio por el tuyo (applinks:<dominio>). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:toolyo.example.com</string>
	</array>
</dict>
</plist>
