# ─────────────────────────────────────────────────────────────
# Toolyo — plantilla de variables de entorno (sin secretos reales)
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Nunca commitees `.env` con credenciales reales.
# ─────────────────────────────────────────────────────────────

# Base de datos (coincide con development/docker-compose.yml)
DATABASE_URL="postgresql://toolyo:toolyo@localhost:5432/toolyo?schema=public"

# OpenAI embeddings (pg_trgm is used automatically when unavailable)
OPENAI_API_KEY=""

# Entorno
NODE_ENV="development"

# Sesión / Auth.js — mínimo 32 bytes en producción
AUTH_SECRET="dev-secret-change-me-please-32chars-min"
AUTH_URL="http://localhost:3000"

# SSO — deshabilitado por defecto hasta revisión legal y configuración
AUTH_GOOGLE_ENABLED="false"
AUTH_APPLE_ENABLED="false"
AUTH_FACEBOOK_ENABLED="false"

# Email — "console" imprime en logs; "resend" requiere RESEND_*
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_FROM=""

# SMS — "console" imprime en logs; "twilio" requiere credenciales aparte
SMS_PROVIDER="console"
# Verificación OTP por SMS deshabilitada por defecto (BACKEND.md / 002-registration)
SMS_OTP_ENABLED="false"

# KYC — "disabled" por defecto; "external" requiere proveedor aprobado
KYC_PROVIDER="disabled"

# Secreto para HMAC de OTP (mínimo 16 caracteres)
OTP_SECRET="dev-otp-secret-change-me"

# Rate limiting — "memory" para desarrollo monoinstancia; "redis" para multiinstancia
RATE_LIMIT_STORE="memory"

# Sesión — cookie opaca respaldada por DB (003-login)
SESSION_COOKIE_NAME="toolyo_session"
SESSION_TTL_SECONDS="3600"
SESSION_REMEMBER_TTL_SECONDS="2592000"

# Backoffice TOTP (use a secret-manager value with at least 32 characters in production)
TOTP_ISSUER="Toolyo"
TOTP_WINDOW="1"
TOTP_RATE_LIMIT_PER_MIN="5"
TOTP_ENCRYPTION_KEY=""

# Búsqueda pública (004-public-search)
# Tiles del mapa — OpenStreetMap por defecto (sin API key)
# NEXT_PUBLIC_ para que esté disponible en el cliente (Leaflet)
NEXT_PUBLIC_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# Geocoding — Nominatim (OpenStreetMap) por defecto; cambiar a proveedor con SLA en producción
GEOCODING_PROVIDER="nominatim"
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
# Rate limiting de búsqueda (umbrales por IP)
SEARCH_RATE_LIMIT_PER_MIN="100"
SUGGEST_RATE_LIMIT_PER_MIN="60"

# ─────────────────────────────────────────────────────────────
# App móvil multiplataforma (014-app-movil-multiplataforma)
# ─────────────────────────────────────────────────────────────
# Endpoint de la API que utiliza el shell nativo. La interfaz se incluye en el paquete móvil; no se carga desde esta URL.
# Ejemplos:
#   Producción (HTTPS, obligatorio): MOBILE_SERVER_URL="https://toolyo.example.com"
#   Red local / intranet (solo builds internas): MOBILE_SERVER_URL="http://192.168.1.50:3000"
MOBILE_SERVER_URL=""
# Permite HTTP en claro (comunicaciones de prueba). En producción debe ser "false".
# Con true, Android usa network_security_config_cleartext.xml (HTTP permitido) y el WebView carga http://.
MOBILE_ALLOW_CLEARTEXT="false"
# Habilita el cambio de endpoint en tiempo de ejecución desde la app. Solo builds internas.
MOBILE_ALLOW_RUNTIME_OVERRIDE="false"
# Dominios adicionales legítimos de navegación en el WebView (auth/pago), separados por coma.
MOBILE_ALLOWED_DOMAINS=""
# Enlaces profundos — valores servidos en /.well-known (no hardcodear en producción)
MOBILE_ANDROID_PACKAGE="com.toolyo.app"
MOBILE_ANDROID_CERT_SHA256=""
MOBILE_IOS_TEAM_ID=""
MOBILE_IOS_BUNDLE_ID="com.toolyo.app"

# Notificaciones push móviles (FCM HTTP v1; entrega a Android y, vía FCM→APNs, a iOS)
PUSH_PROVIDER="console"
FCM_PROJECT_ID=""
FCM_ACCESS_TOKEN=""

